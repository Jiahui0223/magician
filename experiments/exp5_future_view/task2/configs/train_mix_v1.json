{
 "version": "train_mix_v1",
 "protocol": "task2/protocol.md \u00a73",
 "model": "model_v1.json",
 "data_outdoor": "data_v1.json",
 "init_checkpoint": "work_dirs/exp5_future_view/task1/training/main/ema_060000.pt",
 "init_checkpoint_sha256": "a379c0fb9d7d80266a430ab6f48f39315fad54fb650c6c3740a999a02db079fc",
 "train_indoor": "MP3D train houses, t21 shards (n_win = 5 frames)",
