  0.1,
  0.3,
  0.5,
  0.7,
  0.9
 ],
 "eval_sets": {
  "in_val": 2048,
  "out_sc": 2048,
  "in_train": 1024,
  "out_train": 1024
 },
 "selection": {
  "metric": "fair_es_arclength_vox",
  "score": "ES_in_val / ES_in_val(step 0) + ES_out_sc / ES_out_sc(step 0)",
