{
 "version": "v3_train_v1",
 "note": "Frozen 2026-10-30 06:30 (protocol.md v1.0). Shared by T0 and T1; only the arm differs.",
 "model": "model_v3.json",
 "seed": 0,
 "steps": 40000,
 "warmup": 1000,
 "lr": 0.0001,
 "betas": [
  0.9,
  0.99
 ],
 "weight_decay": 0.01,
 "grad_clip": 1.0,
 "ema": 0.999,
 "precision": "bf16",
 "batch_views": 64,
 "states_per_batch": 8,
 "accum": 1,
 "max_cands_per_state": 8,
 "stale_p": 0.5,
 "stale_max": 9,
 "state_weight_t_le": 20,
 "state_weight_factor": 2.0,
 "lambda_rec": 1.0,
 "kl": {
  "beta": 0.02,
  "start": 0,
  "warmup": 5000
 },
 "eval_every": 5000,
 "ckpt_every": 1000,
 "log_every": 50,
 "eval_tau": [
  0.1,
  0.3,
  0.5,
  0.7,
  0.9
 ],
 "eval_sets": {
  "in_val": 2048,
  "out_sc": 2048,
  "in_train": 1024,
  "out_train": 1024
 },
 "selection": {
  "metric": "fair_es_arclength_vox",
  "score": "ES_in_val / ES_in_val(step 5000) + ES_out_sc / ES_out_sc(step 5000)",
  "choose": "minimum over evaluated steps >= 5000, ties -> later step; never an evaluation scene; the chosen EMA is copied to checkpoints/final.pt"
 },
 "smoke": {
  "overfit_steps": 200,
  "short_steps": 300,
  "profile_steps": 100,
  "emulate_world": 4
 },
 "early_stop": {
  "after_fraction": 0.667,
  "patience_evals": 2,
  "rule": "stop if the selection score has not improved for 2 consecutive evaluations after 2/3 of the budget (same rule for both arms)"
 }
}